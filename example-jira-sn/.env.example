# Jira webhook secret — must match what you configure in Jira's webhook settings
# For local testing with send-test-webhook.js, any value works as long as both sides match
JIRA_WEBHOOK_SECRET=change-me-to-a-strong-secret

# ServiceNow outbound
SN_BASE_URL=https://devXXXXX.service-now.com
SN_USER=integra-user
SN_PASS=integra-pass

# Engine
LOG_LEVEL=info
