{
  "name": "@int3gra/engine",
  "version": "1.1.0",
  "type": "module",
  "description": "The int3gra runtime engine",
  "main": "src/index.js",
  "bin": {
    "integra-engine": "src/index.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./loader": "./src/loader.js",
    "./executor": "./src/executor.js",
    "./resolver": "./src/resolver.js",
    "./linter": "./src/linter.js",
    "./logger": "./src/logger.js",
    "./shared": "./src/shared.js",
    "./error": "./src/error.js",
    "./authUtilities": "./src/authUtilities.js",
    "./storage": "./src/storage.js",
    "./binaryUtilities": "./src/binaryUtilities.js",
    "./loadEnvFile": "./src/index.js"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "fastify": "^5.0.0",
    "file-type": "^21.0.0"
  },
  "license": "BSL-1.1",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/",
    "schemas/",
    "README.md"
