{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://integra.dev/schemas/process.json",
  "title": "Process Component",
  "description": "Orchestrates connections and maps via a flow of steps with flow control.",
  "type": "object",
  "required": ["id", "flow"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "input": {
      "type": "string"
    },
    "output": {
      "type": "string"
    },
    "resolver": {
      "type": "string"
    },
    "flow": {
      "$ref": "#/$defs/flow"
    }
  },
  "$defs": {
    "flow": {
      "type": "object",
      "required": ["steps"],
      "additionalProperties": false,
      "properties": {
        "metadata": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "parallel": { "type": "boolean" }
          }
        },
        "steps": {
          "type": "array",
          "items": { "$ref": "#/$defs/step" }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id":      { "type": "string" },
        "onError": { "type": "string" }
      }
    }
  }
}
