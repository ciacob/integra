{
  "name": "int3gra",
  "private": true,
  "version": "1.0.0",
  "description": "Configuration-driven integration engine",
  "workspaces": [
    "packages/engine",
    "packages/cli",
    "packages/manager"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest --passWithNoTests",
    "lint": "eslint packages/*/src",
    "build": "echo 'No build step required for ESM'"
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "nock": "^13.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/packages/*/test/**/*.test.js",
      "**/example-*/test/**/*.test.js"
    ]
  },
  "license": "BSL-1.1",
  "dependencies": {
    "fastify": "^5.8.5",
    "file-type": "^22.0.1"
  }
}
